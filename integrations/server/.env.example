# Copy to /etc/kolvika-leads.env on the server. Never commit real credentials.
LEADS_BIND=127.0.0.1
LEADS_PORT=3210
LEADS_DB_PATH=/var/lib/kolvika-leads/leads.sqlite3

# KOLVIKA amoCRM account and private integration.
AMOCRM_ACCOUNT_URL=https://kolvika.amocrm.ru
# Optional: long-lived access token, if generated in the integration's Keys tab.
AMOCRM_LONG_LIVED_TOKEN=
# OAuth client fields are used only when no long-lived token is configured.
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
AMOCRM_REDIRECT_URI=https://custom.kolvika.jewelry/api/amocrm/callback
# The first refresh token is obtained via the server callback and kept in SQLite.
AMOCRM_PIPELINE_ID=
AMOCRM_STATUS_ID=
AMOCRM_RESPONSIBLE_USER_ID=
AMOCRM_LEAD_FIELD_IDS_JSON={}
