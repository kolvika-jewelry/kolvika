# Copy to /etc/kolvika-leads.env on the server. Never commit real credentials.
LEADS_BIND=127.0.0.1
LEADS_PORT=3210
LEADS_DB_PATH=/var/lib/kolvika-leads/leads.sqlite3

# Fill after the AmoCRM account and field mapping are provided.
AMOCRM_ACCOUNT_URL=https://your-account.amocrm.ru
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
AMOCRM_REDIRECT_URI=https://your-registered-redirect-uri.example
AMOCRM_REFRESH_TOKEN=
AMOCRM_PIPELINE_ID=
AMOCRM_STATUS_ID=
AMOCRM_RESPONSIBLE_USER_ID=
AMOCRM_LEAD_FIELD_IDS_JSON={}
